{
  "name": "valet",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/desktop && tsc --noEmit -p apps/desktop/tsconfig.node.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm coverage",
    "demo": "pnpm --filter @valet/desktop demo",
    "test:e2e": "pnpm --filter @valet/desktop test:e2e",
    "package:smoke": "pnpm --filter @valet/desktop package:smoke",
    "valet:verify-audit": "tsx packages/runtime/src/verify-audit-cli.ts",
    "release": "tsx apps/desktop/scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
