{
  "name": "@valet/desktop",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "valet menu-bar app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview --skipBuild",
    "demo": "electron-vite build --mode demo && VALET_DEMO=1 electron .",
    "test:smoke": "electron-vite build --mode demo && playwright test -c test/smoke/playwright.config.ts",
    "test:e2e": "electron-vite build --mode demo && playwright test -c e2e/playwright.config.ts",
    "package": "electron-vite build && node scripts/package.mjs",
    "package:smoke": "electron-vite build --mode smoke && node scripts/package-smoke.mjs",
    "package:showcase": "electron-vite build --mode showcase && node scripts/package-showcase.mjs",
    "screens:live": "electron-vite build --mode demo && VALET_E2E_SCREENS=1 playwright test -c e2e/playwright.config.ts screens"
  },
  "dependencies": {
    "@1password/sdk": "^0.5.0",
    "@valet/adapter-woolworths": "workspace:*",
    "@valet/adapter-yahoo-finance": "workspace:*",
    "@valet/auth-flow": "workspace:*",
    "@valet/browser-electron": "workspace:*",
    "@valet/core": "workspace:*",
    "@valet/credentials": "workspace:*",
    "@valet/mcp-server": "workspace:*",
    "@valet/runtime": "workspace:*",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@electron/osx-sign": "^1.3.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.0",
    "@valet/fake-woolworths-site": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "builder-util-runtime": "^9.7.0",
    "electron": "^44.10.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.6"
  }
}
