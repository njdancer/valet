<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Node runtime's entitlements (valet-node, docs/node-runtime.md#shipping-the-binary): V8 generates
  code at run time, and nothing else. Not the official build's library-validation, dyld-variable or
  executable-memory exceptions: no native addons load, and nothing in its environment reaches it.
  test/updater/packaging.test.ts fails on any other key.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
