// The desktop app: renderer (DOM and JSX), main process and preload, and their tests. Kept out of the
// root tsconfig so the Node packages typecheck without browser globals: run
// `tsc --noEmit -p apps/desktop` as well as the root check.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Until zod is a dependency of this package: core's copy (src/main/core/zod.ts).
    // The e2e suite's MCP client: the SDK is packages/mcp-server's dependency (e2e/harness.ts).
    "paths": {
      "zod": ["../../packages/core/node_modules/zod"],
      "@modelcontextprotocol/sdk/*": [
        "../../packages/mcp-server/node_modules/@modelcontextprotocol/sdk/dist/esm/*"
      ]
    }
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "vitest.config.ts", "electron.vite.config.ts"]
}
