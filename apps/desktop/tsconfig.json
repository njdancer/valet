// The desktop app: renderer (DOM and JSX), main process and preload, and their tests. Kept out of the
// root tsconfig so the Node packages typecheck without browser globals: run
// `tsc --noEmit -p apps/desktop` as well as the root check.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // Until zod is a dependency of this package: core's copy (src/main/core/zod.ts).
    "paths": { "zod": ["../../packages/core/node_modules/zod"] }
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts", "electron.vite.config.ts"]
}
