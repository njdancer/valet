  {
    "name": "yahoo_finance_get_price_history",
    "title": "Get price history",
    "description": "Open, high, low, close and volume for one symbol over a range (1d to max) at an interval (5m to 1mo).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "pattern": "^[A-Za-z0-9.^=-]+$"
        },
        "range": {
          "default": "1mo",
          "type": "string",
          "enum": [
            "1d",
            "5d",
            "1mo",
            "3mo",
            "6mo",
            "1y",
            "2y",
            "5y",
            "10y",
            "ytd",
            "max"
          ]
        },
        "interval": {
          "default": "1d",
          "type": "string",
          "enum": [
            "5m",
            "15m",
            "30m",
            "60m",
            "1d",
            "1wk",
            "1mo"
          ]
        }
      },
      "required": [
        "symbol"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string"
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "exchange": {
          "type": [
            "string",
            "null"
          ]
        },
        "range": {
          "type": "string"
        },
        "interval": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "type": "string"
              },
              "open": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "high": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "low": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "close": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "adjustedClose": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "volume": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "time",
              "open",
              "high",
              "low",
              "close",
              "adjustedClose",
              "volume"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "symbol",
        "currency",
        "exchange",
        "range",
        "interval",
        "truncated",
        "points"
      ],
