  {
    "name": "yahoo_finance_search_symbols",
    "title": "Search symbols",
    "description": "Finds ticker symbols by company, fund or index name (e.g. \"commonwealth bank\", \"nasdaq\"). Use it to get the symbol get_quote needs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "limit": {
          "default": 8,
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "required": [
        "query"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "exchange": {
                "type": [
                  "string",
                  "null"
                ]
              },
